// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = MoumusicIOS
PRODUCT_BUNDLE_IDENTIFIER = com.jiajia2222.moumusic.ios
// PRODUCT_DISPLAY_NAME is not a real build setting; the Home Screen
// name comes from CFBundleDisplayName.
INFOPLIST_KEY_CFBundleDisplayName = Moumusic
INFOPLIST_KEY_CFBundleDevelopmentRegion = zh-Hans
// Keep local/Xcode builds on the current public release. CI overrides this
// with the version from the v* tag and verifies the final app bundle.
MARKETING_VERSION = 1.0.10
CURRENT_PROJECT_VERSION = 110
DEVELOPMENT_TEAM = 
CODE_SIGN_STYLE = Automatic

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 16.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// UILaunchScreen is declared explicitly in Config/Info.plist. Do not use
// INFOPLIST_KEY_UILaunchScreen_Generation: Xcode can emit a nested value that
// iOS ignores, leaving large devices in letterboxed compatibility mode.
// UIBackgroundModes has no INFOPLIST_KEY_ build setting — it must come from
// the partial Info.plist merged with the generated one.
// The default files are kept in source control. `make configure-carplay`
// writes an untracked overlay that switches these two variables to generated
// CarPlay copies; the ordinary build stays free of restricted entitlements.
KUMONE_INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// ==========================================
// Entitlements
// ==========================================
KUMONE_ENTITLEMENTS_FILE = Config/KumoneIOS.entitlements

// CarPlay.local.xcconfig is deliberately untracked and optional. CarPlay
// Audio is a restricted Apple entitlement, so it must never be forced into
// the default CI or unsigned build.
#include? "CarPlay.local.xcconfig"

INFOPLIST_FILE = $(KUMONE_INFOPLIST_FILE)
CODE_SIGN_ENTITLEMENTS = $(KUMONE_ENTITLEMENTS_FILE)
