# Public creator profile
SITE_NAME=MouMou
SITE_AVATAR=
SITE_TAGLINE=感谢你的支持，每一份心意都会变成继续维护和创造的动力。
SITE_THANKS=感谢每一位支持者，让 Moumusic 可以持续更新。

# Public Afdian destination. This is safe to expose to browsers.
AFDIAN_URL=https://www.ifdian.net/a/moumou2026
AFDIAN_PLAN_URL=https://ifdian.net/a/moumou2026/plan

# Chatway widget settings. The server injects these into the page; no secret is stored here.
CHATWAY_SCRIPT_ID=Ol4m4dkJ9UJP
CHATWAY_WIDGET_ID=qfybc7qkscn3ptkgxwrv

# Server-only Afdian OpenAPI credentials. Never put these in HTML or frontend JS.
AFDIAN_USER_ID=
AFDIAN_TOKEN=

# Set true only if you want the public page to show amounts.
SHOW_SPONSOR_AMOUNT=true

# Optional download links shown on /install. Leave empty to resolve the latest GitHub Release automatically.
IOS_DOWNLOAD_URL=
IOS15_DOWNLOAD_URL=

# Moumusic personal ID card service. Keep the password hash server-side.
# Generate it locally with:
# node --input-type=module -e "import { makeAdminPasswordHash } from './src/moumusic-account.mjs'; console.log(makeAdminPasswordHash(process.argv[1]))" "your-password"
MOUMUSIC_DATA_DIR=./data
MOUMUSIC_SERVER_ID=
MOUMUSIC_SERVER_VERSION=1.0.0
MOUMUSIC_ADMIN_USERNAME=moumou
MOUMUSIC_ADMIN_ID=moumusic-admin
# Optional visible administrator profile ID; it must be unique.
MOUMUSIC_ADMIN_PUBLIC_ID=moumusic-admin
MOUMUSIC_ADMIN_PASSWORD_HASH=
MOUMUSIC_CORS_ORIGIN=
MOUMUSIC_SERVER_IPV4=
MOUMUSIC_SERVER_IPV6=
MOUMUSIC_SERVER_CPU_CORES=
MOUMUSIC_SERVER_MEMORY_MB=
MOUMUSIC_SERVER_STORAGE_GB=
MOUMUSIC_SERVER_NETWORK_MBPS=
PORT=8787
